{
  "name": "nine3q-chrome-extension-avatars-and-things-on-web-pages",
  "version": "1.0.0",
  "description": "Weblin: Avatars and Things on Web Pages",
  "homepage": "https://github.com/lupuslabs/n3qExt/blob/develop/ChromeExt/README.md",
  "scripts": {
    "audit-non-dev-deps": "npm audit --omit=dev",
    "clean:chrome": "node clean.mjs dist",
    "clean:firefox": "node clean.mjs dist-firefox",
    "clean": "npm-run-all clean:*",
    "typecheck": "tsc --noEmit",
    "extension-data:chrome": "node extension-data.mjs chrome",
    "extension-data:firefox": "node extension-data.mjs firefox",
    "extension-data": "npm-run-all extension-data:*",
    "build:contentscript-background": "rspack --config rspack.config.mjs --mode production",
    "build:test": "rspack --config rspack.test.config.mjs",
    "build:embedded": "rspack --config rspack.embedded.config.mjs --mode production",
    "watch:typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "watch:contentscript-background": "rspack --config rspack.config.mjs --mode development -w",
    "watch:test": "rspack --config rspack.test.config.mjs -w",
    "watch:embedded": "rspack --config rspack.embedded.config.mjs --mode development -w",
    "build": "npm-run-all clean extension-data typecheck && npm-run-all --parallel build:*",
    "watch": "npm-run-all clean extension-data && npm-run-all --parallel watch:*",
    "zip:chrome": "bestzip extension.zip dist/*",
    "zip:firefox": "cd dist-firefox && bestzip ../extension-firefox.xpi *",
    "zip": "npm-run-all zip:*",
    "release-extension": "npm-run-all clean extension-data typecheck build:contentscript-background zip",
    "release-embedded": "npm-run-all clean extension-data typecheck build:embedded"
  },
  "bugs": {
    "url": "https://github.com/lupuslabs/n3qExt/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lupuslabs/n3qExt/tree/develop/ChromeExt"
  },
  "keywords": [
    "chrome",
    "extension",
    "typescript",
    "react"
  ],
  "author": "Wolfspelz",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/chai": "5.x",
    "@types/jquery": "3.5.x",
    "@types/chrome": "0.1.x",
    "@types/firefox-webext-browser": "143.0.x",
    "@types/xmpp__jid": "0.14.x",
    "@types/xmpp__xml": "0.14.x",
    "@types/xmpp__client": "0.14.x",
    "@rspack/cli": "1.x",
    "@rspack/core": "1.x",
    "@typescript-eslint/eslint-plugin": "8.x",
    "@typescript-eslint/parser": "8.x",
    "bestzip": "2.x",
    "css-loader": "7.x",
    "eslint": "10.x",
    "globals": "16.x",
    "node-polyfill-webpack-plugin": "4.1.x",
    "npm-run-all2": "8.x",
    "typescript": "5.x"
  },
  "dependencies": {
    "@xmpp/client": "0.14.x",
    "@xmpp/debug": "0.14.x",
    "chai": "6.x",
    "jquery": "3.6.3",
    "loglevel": "1.9.2",
    "unique-names-generator": "4.7.x",
    "ethers": "6.x"
  }
}
